# ── Google OAuth redirect base URL (used to build the callback URI) ──────────
# Set to your public API hostname in production, e.g. https://api.gyanbrige.example.org
API_URL=http://localhost:4000

# ── Next.js frontend (frontend/) ─────────────────────────────────────────────
# Base URL used for QR code generation. Required in production when the server
# is behind a reverse proxy that doesn't pass X-Forwarded-Host.
# NEXT_PUBLIC_QR_HOST=gyanbrige.example.org

# Ollama base URL for the Next.js AI features (generate-notes, transcribe).
# Defaults to http://localhost:11434 if not set.
# OLLAMA_API_URL=http://localhost:11434
